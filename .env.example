# ============================================
# PETA CERITA — Environment Variables
# ============================================
# Copy file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke Git.
# ============================================

# ----- Database (PostgreSQL) -----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Contoh lokal:    postgresql://postgres:postgres@localhost:5432/peta_cerita?schema=public
# Contoh Neon:     postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/peta_cerita?sslmode=require
# Contoh Supabase: postgresql://postgres.xxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peta_cerita?schema=public"

# ----- Auth.js (NextAuth v5) -----
# Generate dengan: npx auth secret
# Atau: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ----- Application -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Peta Cerita"

# ----- Maps (MapLibre) -----
# Default pakai tile gratis OpenStreetMap — tidak butuh API key.
# Untuk style premium (opsional), daftar di:
#   - MapTiler:  https://maptiler.com
#   - Stadia:    https://stadiamaps.com
# Kosongkan kalau pakai OSM default.
NEXT_PUBLIC_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
NEXT_PUBLIC_MAP_API_KEY=""

# ----- Storage (Supabase Storage) -----
# Daftar gratis di https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="peta-cerita"

# ----- Text-to-Speech (opsional) -----
# Default pakai Web Speech API browser — tidak butuh key.
# Untuk premium (opsional):
#   - Google Cloud TTS: https://cloud.google.com/text-to-speech
#   - ElevenLabs:       https://elevenlabs.io
# Kosongkan kalau pakai Web Speech API default.
GOOGLE_TTS_API_KEY=""
ELEVENLABS_API_KEY=""

# ----- Points System (bisa diubah tanpa ubah kode) -----
POINTS_SUBMIT=5
POINTS_APPROVED=50
POINTS_ACHIEVEMENT=100

# ----- Rate Limiting (opsional, untuk production) -----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ----- Development Only -----
# Set ke "true" untuk log query database
DEBUG_PRISMA="false"